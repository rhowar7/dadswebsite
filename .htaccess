# Walter's Home Improvement — Apache config for GoDaddy cPanel (Linux) hosting.
# Upload this file into public_html alongside index.html. It is a hidden file,
# so turn on "Show Hidden Files" in cPanel File Manager to see it.

# ---------------------------------------------------------------------------
# Force HTTPS and the www hostname, so the site has exactly one address.
# Without this the same pages answer on four URLs (http/https x www/non-www),
# which splits Google's view of the site.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.waltershomeimprovement.com%{REQUEST_URI} [L,R=301]

  # non-www -> www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.waltershomeimprovement.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# Friendly error page
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Compression. The HTML and CSS shrink by roughly 70% over the wire.
# Images and PDFs are already compressed, so they are left alone.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching. Photos rarely change, so let returning visitors reuse them.
# HTML is kept short so edits show up promptly.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType application/pdf          "access plus 1 month"
  ExpiresByType text/html                "access plus 1 hour"
</IfModule>

# ---------------------------------------------------------------------------
# Basic hardening
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Don't let visitors browse raw folder listings (e.g. /images/)
Options -Indexes
